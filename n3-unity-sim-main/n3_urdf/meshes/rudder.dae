<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <created>2025-01-01</created>
    <modified>2025-01-01</modified>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>

  <library_effects>
    <effect id="rudder_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission><color>0 0 0 1</color></emission>
            <ambient><color>0.1 0.1 0.1 1</color></ambient>
            <diffuse><color>0.9 0.7 0.1 1.0</color></diffuse>
            <specular><color>0.4 0.4 0.4 1</color></specular>
            <shininess><float>40</float></shininess>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

  <library_materials>
    <material id="rudder_mat" name="rudder_mat">
      <instance_effect url="#rudder_effect"/>
    </material>
  </library_materials>

  <library_geometries>
    <geometry id="rudder" name="rudder">
      <mesh>
        <source id="rudder-positions">
          <float_array id="rudder-positions-array" count="24">
            -0.600000 -0.020000 -0.800000 0.000000 -0.020000 -0.800000 0.000000 0.020000 -0.800000 -0.600000 0.020000 -0.800000 -0.600000 -0.020000 0.000000 0.000000 -0.020000 0.000000 0.000000 0.020000 0.000000 -0.600000 0.020000 0.000000
          </float_array>
          <technique_common>
            <accessor source="#rudder-positions-array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <source id="rudder-normals">
          <float_array id="rudder-normals-array" count="108">
            0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000
          </float_array>
          <technique_common>
            <accessor source="#rudder-normals-array" count="36" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <vertices id="rudder-vertices">
          <input semantic="POSITION" source="#rudder-positions"/>
        </vertices>

        <triangles count="12" material="rudder_mat">
          <input semantic="VERTEX" source="#rudder-vertices" offset="0"/>
          <input semantic="NORMAL" source="#rudder-normals"  offset="1"/>
          <p>0 0 1 1 2 2 0 3 2 4 3 5 4 6 6 7 5 8 4 9 7 10 6 11 0 12 4 13 5 14 0 15 5 16 1 17 2 18 6 19 7 20 2 21 7 22 3 23 1 24 5 25 6 26 1 27 6 28 2 29 0 30 3 31 7 32 0 33 7 34 4 35</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>

  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="rudder_node" name="rudder" type="NODE">
        <instance_geometry url="#rudder">
          <bind_material>
            <technique_common>
              <instance_material symbol="rudder_mat"
                                 target="#rudder_mat"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>

  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
