<?xml version="1.0"?>
<robot name="usv">

  <link name="base_link"/>
  <link name="camera_link"/>

  <joint name="camera_mount" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <!-- pitch the camera down slightly by setting rpy-->
    <origin xyz="3 10 0" rpy="0 0 0"/>
  </joint>

</robot>
